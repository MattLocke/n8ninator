{
  "name": "n8ninator",
  "version": "0.1.0",
  "description": "A local-first n8n coding agent powered by Ollama and MCP.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dompurify": "^3.3.1",
    "express": "^5.2.1",
    "marked": "^17.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  }
}
